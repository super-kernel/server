{
    "name": "super-kernel/server",
    "description": "Swoole server startup services and console command for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "ext-reflection": "*",
        "ext-swoole": ">=6.2.3 <6.3",
        "psr/container": "^2.0.2",
        "psr/event-dispatcher": "^1.0",
        "super-kernel/attribute": "dev-main",
        "super-kernel/config": "dev-main",
        "super-kernel/contract": "dev-main",
        "super-kernel/swoole": "dev-main",
        "symfony/console": "^8.1.9"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.3",
        "swoole/ide-helper": "^6.2.3"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\Server\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
